        PRT_Printf("[openamp] tty endpoint ret:%d \n", ret);
        goto err;
    }

    while (tty_ept.addr !=  RPMSG_ADDR_ANY) {
        PRT_SemPend(tty_sem, OS_WAIT_FOREVER);
        intSave = PRT_HwiLock();
        if (tty_msg_count == 0U) {
            PRT_HwiRestore(intSave);
            continue;
        }
        tty_msg = tty_msg_queue[tty_msg_head];
        tty_msg_head = (tty_msg_head + 1U) % RPMSG_TTY_RX_QUEUE_DEPTH;
