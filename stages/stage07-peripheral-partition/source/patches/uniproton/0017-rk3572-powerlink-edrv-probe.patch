+++ b/demos/rk3572_mica/CMakeLists.txt
@@ -1,3 +1,13 @@
 cmake_minimum_required(VERSION 3.12)
+option(M7_POWERLINK_EDRV_PROBE "Explicit bounded UP2 EDRV frame diagnostic" OFF)
