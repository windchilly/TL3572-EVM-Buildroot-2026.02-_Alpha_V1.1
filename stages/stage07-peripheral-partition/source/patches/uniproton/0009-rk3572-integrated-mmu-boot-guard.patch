@@ -22,6 +22,13 @@
     add_compile_definitions(M7_INTEGRATED_FIRMWARE=1)
 endif()
 
+# Keep legacy targets byte-for-byte on their original table budget.
+if(M7_INTEGRATED_FIRMWARE)
+    set(M7_MMU_TABLE_BYTES 0x10000)
+else()
+    set(M7_MMU_TABLE_BYTES 0x8000)
+endif()
