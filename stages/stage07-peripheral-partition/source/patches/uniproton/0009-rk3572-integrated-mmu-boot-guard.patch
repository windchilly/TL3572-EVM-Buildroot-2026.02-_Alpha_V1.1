diff --git a/demos/rk3572_mica/bsp/print.c b/demos/rk3572_mica/bsp/print.c
--- a/demos/rk3572_mica/bsp/print.c
+++ b/demos/rk3572_mica/bsp/print.c
@@ -92,3 +92,30 @@
 }
 
+#if defined(M7_INTEGRATED_FIRMWARE)
+/* MMU failure can precede BSS/libc initialization: scalar volatile writes only. */
+void UpLogMmuFailure(void)
+{
+    static const char message[] = "[boot] MMU FAIL initialization/readback; CPU_OFF\n";
+    volatile struct UpLogRecord *record;
+    U32 i, seq;
+    unsigned long flags;
+    UpLogBoot();
+    flags = UpLogIrqSave();
+    seq = g_upLogHeader->writeSeq + 1U;
+    record = &g_upLogRecords[(seq - 1U) % UP_LOG_RECORD_COUNT];
+    record->committedSeq = 0U;
+    record->bootId = g_upLogHeader->bootId;
+    record->length = sizeof(message) - 1U;
+    record->reserved = 0U;
+    for (i = 0U; i < sizeof(message); ++i) {
+        record->text[i] = message[i];
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+    record->committedSeq = seq;
+    __asm__ volatile("dsb sy" ::: "memory");
+    g_upLogHeader->writeSeq = seq;
+    UpLogIrqRestore(flags);
+}
+#endif
+
 static int UpLogVprintf(const char *format, va_list args)
