diff --git a/demos/rk3572_mica/CMakeLists.txt b/demos/rk3572_mica/CMakeLists.txt
--- a/demos/rk3572_mica/CMakeLists.txt
+++ b/demos/rk3572_mica/CMakeLists.txt
@@ -1,3 +1,14 @@
 cmake_minimum_required(VERSION 3.12)
+option(M7_POWERLINK_MN "Dormant UP2 MN owner, software commands only" OFF)
+if(M7_POWERLINK_MN)
+    if(NOT M7_INTEGRATED_FIRMWARE OR NOT M7_POWERLINK_EDRV OR NOT M7_POWERLINK_RTOS)
+        message(FATAL_ERROR "MN owner requires cumulative EDRV/RTOS candidate")
+    endif()
+    add_compile_definitions(M7_POWERLINK_MN=1)
+    if(MCS_CLIENT_CPU_ID STREQUAL "5" AND NOT EXISTS "${M7_POWERLINK_OBJECT}")
+        message(FATAL_ERROR "Set M7_POWERLINK_OBJECT to audited full P3a object")
+    endif()
+endif()
+
 project(exmaples LANGUAGES C ASM)
 
@@ -129,3 +140,8 @@
 add_subdirectory(${HOME_PATH}/src/component/mica mica)
 list(APPEND OBJS $<TARGET_OBJECTS:rpmsg> $<TARGET_OBJECTS:proxy> $<TARGET_OBJECTS:bsp> $<TARGET_OBJECTS:config> $<TARGET_OBJECTS:mica>)
 add_executable(${APP} ${OBJS})
+if(M7_POWERLINK_MN AND MCS_CLIENT_CPU_ID STREQUAL "5")
+    target_sources(${APP} PRIVATE "${M7_POWERLINK_OBJECT}")
+    # Retain ALL core/OD/port code, not only the currently dormant call graph.
+    target_link_options(${APP} PRIVATE -Wl,--no-gc-sections "-Wl,-Map=${CMAKE_CURRENT_BINARY_DIR}/mn.map")
+endif()
diff --git a/demos/rk3572_mica/apps/openamp/CMakeLists.txt b/demos/rk3572_mica/apps/openamp/CMakeLists.txt
--- a/demos/rk3572_mica/apps/openamp/CMakeLists.txt
+++ b/demos/rk3572_mica/apps/openamp/CMakeLists.txt
@@ -63,1 +63,10 @@
+if(M7_POWERLINK_MN AND MCS_CLIENT_CPU_ID STREQUAL "5")
+    # Already supplied once by the audited full object; avoid duplicate ports.
+    list(REMOVE_ITEM SRC powerlink-port/edrv-rk3572.c
+         powerlink-port/target-uniproton.c powerlink-port/hrestimer-rk3572.c)
+    list(APPEND SRC rk3572_powerlink_app.c)
+    # Deliberately NO oplkinc.h force include on RTOS translation units.
+    set_source_files_properties(rk3572_powerlink_app.c PROPERTIES
+        COMPILE_OPTIONS "-Werror;-mgeneral-regs-only;-mno-outline-atomics")
+endif()
 add_library(rpmsg OBJECT ${SRC})
