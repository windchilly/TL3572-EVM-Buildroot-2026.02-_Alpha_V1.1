+        message(FATAL_ERROR "Set audited M7_POWERLINK_TIMER_OBJECT")
+    endif()
+    add_compile_definitions(M7_POWERLINK_TIMER_PROBE=1)
+endif()
 option(M7_POWERLINK_MN "Dormant UP2 MN owner, software commands only" OFF)
 if(M7_POWERLINK_MN)
