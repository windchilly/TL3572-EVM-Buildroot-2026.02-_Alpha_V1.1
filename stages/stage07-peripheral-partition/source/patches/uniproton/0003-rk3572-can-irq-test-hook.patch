diff --git a/demos/rk3572_mica/CMakeLists.txt b/demos/rk3572_mica/CMakeLists.txt
--- a/demos/rk3572_mica/CMakeLists.txt
+++ b/demos/rk3572_mica/CMakeLists.txt
@@ -10,3 +10,7 @@
 option(M7_CAN_DIRECT_TEST "Run the RK3572 UP1/UP2 direct CAN test" OFF)
+option(M7_CAN_IRQ_TEST "Use owned CRU/IOC initialization and CAN IRQs" OFF)
+if(M7_CAN_IRQ_TEST AND NOT M7_CAN_DIRECT_TEST)
+    message(FATAL_ERROR "M7_CAN_IRQ_TEST requires M7_CAN_DIRECT_TEST")
+endif()
 
 configure_file(
@@ -37,5 +41,8 @@
 if(M7_CAN_DIRECT_TEST)
     add_compile_definitions(M7_CAN_DIRECT_TEST=1)
 endif()
+if(M7_CAN_IRQ_TEST)
+    add_compile_definitions(M7_CAN_IRQ_TEST=1)
+endif()
 
 include(${HOME_PATH}/cmake/functions/uniproton_functions.cmake)
diff --git a/demos/rk3572_mica/apps/openamp/CMakeLists.txt b/demos/rk3572_mica/apps/openamp/CMakeLists.txt
--- a/demos/rk3572_mica/apps/openamp/CMakeLists.txt
+++ b/demos/rk3572_mica/apps/openamp/CMakeLists.txt
@@ -1,5 +1,9 @@
 set(SRC main.c)
 if(M7_CAN_DIRECT_TEST)
-    list(APPEND SRC rk3572_can_test.c)
+    if(M7_CAN_IRQ_TEST)
+        list(APPEND SRC rk3572_can_irq_test.c)
+    else()
+        list(APPEND SRC rk3572_can_test.c)
+    endif()
 endif()
 add_library(rpmsg OBJECT ${SRC})
