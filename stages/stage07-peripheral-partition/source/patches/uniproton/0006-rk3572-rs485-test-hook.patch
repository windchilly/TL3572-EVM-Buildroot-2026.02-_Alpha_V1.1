diff --git a/demos/rk3572_mica/CMakeLists.txt b/demos/rk3572_mica/CMakeLists.txt
--- a/demos/rk3572_mica/CMakeLists.txt
+++ b/demos/rk3572_mica/CMakeLists.txt
@@ -16,2 +16,6 @@
 option(M7_RS232_TEST "Run direct UART4/UART8 IRQ test (physical UART4/UART3)" OFF)
+option(M7_RS485_TEST "Run direct half-duplex UART1/UART2 IRQ test" OFF)
+if(M7_RS485_TEST AND (M7_CAN_DIRECT_TEST OR M7_RS232_TEST))
+    message(FATAL_ERROR "RS485, RS232 and CAN tests require independent builds")
+endif()
 set(M7_RS232_BAUD 115200 CACHE STRING "RS232 test baud: 9600, 38400 or 115200")
@@ -59,2 +63,6 @@
 endif()
+set(M7_RS485_BAUD 115200 CACHE STRING "RS485 test baud: 9600, 38400 or 115200")
+if(M7_RS485_TEST)
+    add_compile_definitions(M7_RS485_TEST=1 M7_RS485_BAUD=${M7_RS485_BAUD})
+endif()
 
