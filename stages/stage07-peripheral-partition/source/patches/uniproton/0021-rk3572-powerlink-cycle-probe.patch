diff --git a/demos/rk3572_mica/CMakeLists.txt b/demos/rk3572_mica/CMakeLists.txt
--- a/demos/rk3572_mica/CMakeLists.txt
+++ b/demos/rk3572_mica/CMakeLists.txt
@@ -1,3 +1,13 @@
 cmake_minimum_required(VERSION 3.12)
+option(M7_POWERLINK_CYCLE_PROBE "One-shot bounded UP2 MN cycle diagnostic" OFF)
+if(M7_POWERLINK_CYCLE_PROBE)
+    if(NOT M7_POWERLINK_NMT_HEAP OR NOT M7_POWERLINK_NMT_PROBE OR NOT MCS_CLIENT_CPU_ID STREQUAL "5")
+        message(FATAL_ERROR "Cycle diagnostic requires explicit UP2 1MiB NMT candidate")
+    endif()
+    if(NOT EXISTS "${M7_POWERLINK_CYCLE_OBJECT}")
+        message(FATAL_ERROR "Set audited M7_POWERLINK_CYCLE_OBJECT")
+    endif()
+    add_compile_definitions(M7_POWERLINK_CYCLE_PROBE=1)
+endif()
 option(M7_POWERLINK_NMT_HEAP "UP2 full PDO NMT candidate 1MiB FSC heap" OFF)
 if(M7_POWERLINK_NMT_HEAP)
@@ -218,3 +228,6 @@
 if(M7_POWERLINK_NMT_PROBE)
     target_sources(${APP} PRIVATE "${M7_POWERLINK_NMT_OBJECT}")
 endif()
+if(M7_POWERLINK_CYCLE_PROBE)
+    target_sources(${APP} PRIVATE "${M7_POWERLINK_CYCLE_OBJECT}")
+endif()
