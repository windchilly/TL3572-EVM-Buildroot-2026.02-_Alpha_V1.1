diff --git a/demos/rk3572_mica/CMakeLists.txt b/demos/rk3572_mica/CMakeLists.txt
--- a/demos/rk3572_mica/CMakeLists.txt
+++ b/demos/rk3572_mica/CMakeLists.txt
@@ -13,6 +13,14 @@ if(M7_CAN_IRQ_TEST AND NOT M7_CAN_DIRECT_TEST)
     message(FATAL_ERROR "M7_CAN_IRQ_TEST requires M7_CAN_DIRECT_TEST")
 endif()
 
+option(M7_INTEGRATED_FIRMWARE "Cumulative CAN/RS232/RS485 with passive boot" OFF)
+if(M7_INTEGRATED_FIRMWARE)
+    if(M7_CAN_DIRECT_TEST OR M7_CAN_IRQ_TEST)
+        message(FATAL_ERROR "Integrated mode uses runtime dispatch, not legacy boot tests")
+    endif()
+    add_compile_definitions(M7_INTEGRATED_FIRMWARE=1)
+endif()
+
 configure_file(
     ${CMAKE_CURRENT_SOURCE_DIR}/bsp/rk3572/rk3572_mica.ld.in
     ${CMAKE_CURRENT_BINARY_DIR}/rk3572_mica.ld
