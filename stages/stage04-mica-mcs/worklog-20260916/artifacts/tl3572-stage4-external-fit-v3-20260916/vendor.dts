			snps,dis_enblslpm_quirk;
			snps,parkmode-disable-hs-quirk;
			snps,parkmode-disable-ss-quirk;
			status = "okay";
			usb-role-switch;
		};

		usb@24400000 {
			clock-names = "ref\0suspend\0bus_clk";
			clocks = <0x03 0x113 0x03 0x114 0x03 0x112>;
			compatible = "rockchip,rk3572-dwc3\0rockchip,rk3576-dwc3\0snps,dwc3";
			dma-coherent;
			dr_mode = "host";
			interrupts = <0x00 0xfe 0x04>;
			phandle = <0x408>;
			phy-names = "usb2-phy\0usb3-phy";
			phy_type = "utmi_wide";
			phys = <0x6b 0x6c 0x04>;
			power-domains = <0x68 0x05>;
			reg = <0x00 0x24400000 0x00 0x400000>;
			reset-names = "usb3-otg";
			resets = <0x03 0xe2>;
			snps,dis-del-phy-power-chg-quirk;
			snps,dis-tx-ipgap-linecheck-quirk;
			snps,dis-u1-entry-quirk;
			snps,dis-u2-entry-quirk;
			snps,dis-u2-freeclk-exists-quirk;
			snps,dis_enblslpm_quirk;
			snps,dis_u2_susphy_quirk;
			snps,parkmode-disable-hs-quirk;
			snps,parkmode-disable-ss-quirk;
			snps,usb2-lpm-disable;
			status = "okay";
		};

		vdpp@27131000 {
			assigned-clock-rates = <0x23c34600 0x23c34600>;
			assigned-clocks = <0x03 0x17f 0x03 0x180>;
			clock-names = "aclk\0hclk\0sclk";
			clocks = <0x03 0x17f 0x03 0x17e 0x03 0x180>;
			compatible = "rockchip,vdpp-rk3572";
			interrupt-names = "irq_vdpp";
			interrupts = <0x00 0xc6 0x04>;
			iommus = <0xc3>;
			phandle = <0x42a>;
			power-domains = <0x68 0x07>;
			reg = <0x00 0x27131000 0x00 0x500 0x00 0x27132800 0x00 0x50>;
			reg-names = "vdpp_regs\0zme_regs";
			reset-names = "shared_rst_a\0shared_rst_h\0shared_rst_s";
			resets = <0x03 0x14a 0x03 0x149 0x03 0x14b>;
			rockchip,disable-auto-freq;
			rockchip,normal-rates = <0x23c34600 0x00 0x23c34600>;
			rockchip,resetgroup-node = <0x01>;
			rockchip,skip-pmu-idle-request;
			rockchip,srv = <0xc1>;
			rockchip,taskqueue-node = <0x01>;
			status = "okay";
		};

		vop@27100000 {
			clock-names = "aclk_vop\0dclk_vop\0hclk_vop";
			clocks = <0x03 0x185 0x03 0x186 0x03 0x184>;
			compatible = "rockchip,rk3572-vop-lit";
			interrupts = <0x00 0xc1 0x04>;
			phandle = <0x425>;
			power-domain-names = "pd0\0pd1";
			power-domains = <0x68 0x07 0x68 0x0b>;
			reg = <0x00 0x27100000 0x00 0x200>;
			reg-names = "regs";
			rockchip,grf = <0x3f>;
			rockchip,vo0-grf = <0xbb>;
			status = "disabled";

			port {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x29>;

				endpoint@0 {
					phandle = <0x71>;
					reg = <0x00>;
					remote-endpoint = <0xbc>;
				};

				endpoint@1 {
					phandle = <0xde>;
					reg = <0x01>;
					remote-endpoint = <0xbd>;
				};

				endpoint@2 {
					phandle = <0xda>;
					reg = <0x02>;
					remote-endpoint = <0xbe>;
				};

				endpoint@3 {
					phandle = <0xd8>;
					reg = <0x03>;
					remote-endpoint = <0xbf>;
				};
			};
		};

		vop@27500000 {
			clock-names = "aclk_vop\0hclk_vop\0dclk_vp0\0dclk_vp1\0dclk_src_vp0\0dclk_src_vp1";
			clocks = <0x03 0x1a8 0x03 0x1a7 0x03 0x1ab 0x03 0x1ac 0x03 0x1a9 0x03 0x1aa>;
			compatible = "rockchip,rk3572-vop";
			interrupt-names = "vop-sys\0vop-vp0\0vop-vp1";
			interrupts = <0x00 0x149 0x04 0x00 0x148 0x04 0x00 0x147 0x04>;
			iommus = <0xca>;
			phandle = <0x42d>;
			power-domains = <0x68 0x0d>;
			reg = <0x00 0x27500000 0x00 0x3c00 0x00 0x27505000 0x00 0x1000 0x00 0x27506400 0x00 0x800 0x00 0x27506c00 0x00 0x300>;
			reg-names = "regs\0gamma_lut\0acm_regs\0sharp_regs";
			reset-names = "dclk_vp0\0dclk_vp1";
			resets = <0x03 0x16d 0x03 0x16e>;
			rockchip,aclk-advanced-mode-rates = <0x29d7ab80>;
			rockchip,aclk-normal-mode-rates = <0x1dcd6500>;
			rockchip,aclk-reset-mode-rates = <0x2367b880>;
			rockchip,disable-afbc-mask = <0x02>;
			rockchip,ioc-grf = <0x3f>;
			status = "okay";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x28>;

				port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x42e>;
					reg = <0x00>;

					endpoint@0 {
						phandle = <0x70>;
						reg = <0x00>;
						remote-endpoint = <0xcb>;
					};

					endpoint@1 {
						phandle = <0xdd>;
						reg = <0x01>;
						remote-endpoint = <0xcc>;
					};

					endpoint@2 {
						phandle = <0xd9>;
						reg = <0x02>;
						remote-endpoint = <0xcd>;
					};

					endpoint@3 {
						phandle = <0x30>;
						reg = <0x03>;
						remote-endpoint = <0xce>;
					};
				};

				port@1 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x42f>;
					reg = <0x01>;

					endpoint@0 {
						phandle = <0x2d>;
						reg = <0x00>;
						remote-endpoint = <0xcf>;
					};

					endpoint@1 {
						phandle = <0x2e>;
						reg = <0x01>;
						remote-endpoint = <0xd0>;
					};

					endpoint@2 {
						phandle = <0x2f>;
						reg = <0x02>;
						remote-endpoint = <0xd1>;
					};

					endpoint@3 {
						phandle = <0xd7>;
						reg = <0x03>;
						remote-endpoint = <0xd2>;
					};
				};
			};
		};

		vpss@27430000 {
			clock-names = "aclk_vpss\0hclk_vpss\0clk_vpss";
			clocks = <0x03 0x197 0x03 0x198 0x03 0x199>;
			compatible = "rockchip,rk3572-rkvpss";
			interrupt-names = "mi_irq\0vpss_irq";
			interrupts = <0x00 0xd7 0x04 0x00 0xd8 0x04>;
			iommus = <0xc9>;
			phandle = <0x5f>;
			power-domains = <0x68 0x09>;
			reg = <0x00 0x27430000 0x00 0x3f00>;
			status = "okay";
		};

		watchdog@2c0c0000 {
			clock-names = "tclk\0pclk";
			clocks = <0x03 0xa9 0x03 0xa8>;
			compatible = "snps,dw-wdt";
			interrupts = <0x00 0x19 0x04>;
			phandle = <0x4b4>;
			reg = <0x00 0x2c0c0000 0x00 0x100>;
			status = "disabled";
		};
	};

	spdif-rx0-dc {
		#sound-dai-cells = <0x00>;
		compatible = "rockchip,dummy-codec";
		phandle = <0x18d>;
	};

	spdif-rx0-sound {
		compatible = "simple-audio-card";
		phandle = <0x4ce>;
		simple-audio-card,name = "rockchip,spdif-rx0";
		status = "disabled";

		simple-audio-card,codec {
			sound-dai = <0x18d>;
		};

		simple-audio-card,cpu {
			sound-dai = <0x18c>;
		};
	};

	spdif-tx0-dc {
		#sound-dai-cells = <0x00>;
		compatible = "rockchip,dummy-codec";
		phandle = <0x18f>;
	};

	spdif-tx0-sound {
		compatible = "simple-audio-card";
		phandle = <0x4cf>;
		simple-audio-card,mclk-fs = <0x80>;
		simple-audio-card,name = "rockchip,spdif-tx0";
		status = "disabled";

		simple-audio-card,codec {
			sound-dai = <0x18f>;
		};

		simple-audio-card,cpu {
			sound-dai = <0x18e>;
		};
	};

	test-power {
		status = "okay";
	};

	thermal-zones {
		phandle = <0x3fb>;

		bigcore-thermal {
			phandle = <0x405>;
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x14>;
			thermal-sensors = <0x65 0x04>;

			trips {

				bigcore-crit {
					hysteresis = <0x7d0>;
					phandle = <0x406>;
					temperature = <0x1c138>;
					type = "critical";
				};
			};
		};

		ddr-thermal {
			phandle = <0x400>;
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x14>;
			thermal-sensors = <0x65 0x02>;

			trips {

				ddr-crit {
					hysteresis = <0x7d0>;
					phandle = <0x401>;
					temperature = <0x1c138>;
					type = "critical";
				};
			};
		};

		gpu-npu-thermal {
			phandle = <0x3fe>;
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x14>;
			thermal-sensors = <0x65 0x01>;

			trips {

				gpu-npu-crit {
					hysteresis = <0x7d0>;
					phandle = <0x3ff>;
					temperature = <0x1c138>;
					type = "critical";
				};
			};
		};

		littlecore-thermal {
			phandle = <0x402>;
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x14>;
			sustainable-power = <0x352>;
			thermal-sensors = <0x65 0x03>;

			cooling-maps {

				map0 {
					contribution = <0x400>;
					cooling-device = <0x04 0xffffffff 0xffffffff>;
					trip = <0x66>;
				};

				map1 {
					contribution = <0x400>;
					cooling-device = <0x08 0xffffffff 0xffffffff>;
					trip = <0x66>;
				};

				map2 {
					contribution = <0x400>;
					cooling-device = <0x0a 0xffffffff 0xffffffff>;
					trip = <0x66>;
				};

				map3 {
					contribution = <0x400>;
					cooling-device = <0x67 0xffffffff 0xffffffff>;
					trip = <0x66>;
				};
			};

			trips {

				littlecore-crit {
					hysteresis = <0x7d0>;
					phandle = <0x404>;
					temperature = <0x1c138>;
					type = "critical";
				};

				trip-point-0 {
					hysteresis = <0x7d0>;
					phandle = <0x403>;
					temperature = <0x1c138>;
					type = "passive";
				};

				trip-point-1 {
					hysteresis = <0x7d0>;
					phandle = <0x66>;
					temperature = <0x1c138>;
					type = "passive";
				};
			};
		};

		soc-thermal {
			phandle = <0x3fc>;
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x14>;
			thermal-sensors = <0x65 0x00>;

			trips {

				soc-crit {
					hysteresis = <0x7d0>;
					phandle = <0x3fd>;
					temperature = <0x1c138>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xff08 0x01 0x0e 0xff08 0x01 0x0b 0xff08 0x01 0x0a 0xff08>;
	};

	usb3-switch {
		compatible = "broadchip,bct4360\0gpio-sbu-mux";
		orientation-switch;
		phandle = <0x13e>;
		select-gpios = <0x191 0x0c 0x00>;
	};

	vbus5v0-typec {
		compatible = "regulator-fixed";
		enable-active-high;
