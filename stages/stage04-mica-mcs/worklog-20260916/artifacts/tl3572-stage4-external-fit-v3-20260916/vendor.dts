		phandle = <0x4d5>;
		pinctrl-0 = <0x193>;
		pinctrl-names = "default";
		regulator-name = "vcc_mipicsi1";
	};

	vcc12v-dcin {
		compatible = "regulator-fixed";
		phandle = <0x4d0>;
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <0xb71b00>;
		regulator-min-microvolt = <0xb71b00>;
		regulator-name = "vcc12v_dcin";
	};

	vcc3v3-lcd {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x13b 0x0f 0x00>;
		phandle = <0xe1>;
		regulator-boot-on;
		regulator-max-microvolt = <0x325aa0>;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "vcc3v3_lcd";
	};

	vcc3v3-pcie0 {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x163 0x1c 0x00>;
		phandle = <0xe7>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "vcc3v3_pcie0";
	};

	vcc3v3-rtc-s5 {
		compatible = "regulator-fixed";
		phandle = <0x4d2>;
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <0x325aa0>;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "vcc3v3_rtc_s5";
	};

	vcc5v0-device {
		compatible = "regulator-fixed";
		phandle = <0x4d1>;
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-name = "vcc5v0_device";
	};

	vcc5v0-sys {
		compatible = "regulator-fixed";
		phandle = <0x78>;
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-name = "vcc5v0_sys_s5";
