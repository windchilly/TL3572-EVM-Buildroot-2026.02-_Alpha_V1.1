		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
			phandle = <0x1ca>;
		};

		scmi {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			arm,smc-id = <0x82000010>;
			compatible = "arm,scmi-smc";
			phandle = <0x1c9>;
			shmem = <0x36>;

			protocol@14 {
				#clock-cells = <0x01>;
