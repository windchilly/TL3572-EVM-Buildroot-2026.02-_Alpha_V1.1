	vdd2l-0v9-ddr-s3 {
		compatible = "regulator-fixed";
		phandle = <0x4d6>;
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <0xdbba0>;
		regulator-min-microvolt = <0xdbba0>;
