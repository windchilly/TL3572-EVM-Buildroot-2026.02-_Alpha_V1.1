	};

	clocks {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		aupll-ref-io {
			#clock-cells = <0x00>;
			clock-frequency = <0x16e3600>;
			clock-output-names = "aupll_ref_io";
			compatible = "fixed-clock";
			phandle = <0x198>;
			pinctrl-0 = <0x02>;
			pinctrl-names = "default";
		};

		clk-acc-audio-frac-0@26090000 {
			#clock-cells = <0x00>;
			clock-names = "ref_clk\0adjust_clk";
			clock-output-names = "clk_acc_audio_frac_0";
			clocks = <0x03 0x34 0x03 0x19>;
			compatible = "rockchip,rk3572-clock-acc";
			interrupts = <0x00 0x151 0x04>;
			phandle = <0x1b7>;
			reg = <0x00 0x26090000 0x00 0x1000>;
		};

		clk-acc-audio-frac-1@26090000 {
			#clock-cells = <0x00>;
